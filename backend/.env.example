# Somente desenvolvimento local; não use estas senhas em produção.
DATABASE_URL=postgresql://askdb_reader:askdb_reader_dev@127.0.0.1:5433/askdb
ASKDB_ADMIN_PASSWORD=askdb_admin_dev
ASKDB_READER_PASSWORD=askdb_reader_dev
ASKDB_POSTGRES_PORT=5433
ASKDB_DEMO_POSTGRES_PORT=5434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
LLM_TIMEOUT=120
CONNECT_TIMEOUT=5
LLM_PROVIDER=ollama
LLM_CONTEXT_WINDOW=16384
LLM_OUTPUT_RESERVE=2048
ASKDB_MAX_ROWS=100
# LLM_MODEL substitui o modelo do provedor configurado, se necessário.
# ASKDB_APP_DATA_DIR deve ser absoluto; o padrão Windows é LOCALAPPDATA/AskDB.
# Chaves remotas: use DEEPSEEK_API_KEY ou OPENAI_API_KEY no ambiente do processo,
# ou a entrada oculta da CLI. A aplicação não lê chaves remotas deste arquivo.
